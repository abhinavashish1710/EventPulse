@page
@model EventPulse.Areas.Identity.Pages.Account.LoginModel
@{
    ViewData["Title"] = "Log in";
}

<h1>Log in</h1>

<div class="auth-form" style="max-width:420px;">
    <form method="post">
        <div asp-validation-summary="All" class="text-danger"></div>

        <div class="form-group">
            <label asp-for="Input.Email"></label>
            <input asp-for="Input.Email" class="form-control" autocomplete="username" />
            <span asp-validation-for="Input.Email" class="text-danger"></span>
        </div>
        <div class="form-group">
            <label asp-for="Input.Password"></label>
            <input asp-for="Input.Password" class="form-control" autocomplete="current-password" />
            <span asp-validation-for="Input.Password" class="text-danger"></span>
        </div>
        <div class="form-group">
            <label>
                <input asp-for="Input.RememberMe" />
                Remember me?
            </label>
        </div>
        <button type="submit" class="btn btn-primary">Log in</button>
    </form>

    <p class="muted" style="margin-top:16px;">
        Don't have an account? <a asp-page="./Register" asp-route-returnUrl="@Model.ReturnUrl">Register</a>
    </p>

    <p class="muted">
        Demo logins: admin@eventpulse.com / Admin@123 &middot; organizer@eventpulse.com / Organizer@123 &middot; attendee@eventpulse.com / Attendee@123
    </p>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
