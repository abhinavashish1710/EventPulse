@{
    ViewData["Title"] = "Checkout";
    int registrationId = ViewBag.RegistrationId;
    string eventName = ViewBag.EventName;
    decimal amount = ViewBag.Amount;
}

<h1>Checkout</h1>
<p class="muted">This is a simulated payment gateway — no real card details are sent anywhere.</p>

<div class="checkout-card" style="max-width:420px; border:1px solid #ddd; border-radius:8px; padding:24px;">
    <p><strong>@eventName</strong></p>
    <p class="price" style="font-size:1.4rem;">@amount.ToString("C")</p>

    <div id="payForm">
        <div class="form-group">
            <label>Name on card</label>
            <input id="cardName" class="form-control" placeholder="As shown on card" />
        </div>
        <div class="form-group">
            <label>Card number</label>
            <input id="cardNumber" class="form-control" placeholder="4242 4242 4242 4242" maxlength="19" />
        </div>
        <div class="form-group" style="display:flex; gap:12px;">
            <div style="flex:1;">
                <label>Expiry</label>
                <input id="cardExpiry" class="form-control" placeholder="MM/YY" maxlength="5" />
            </div>
            <div style="flex:1;">
                <label>CVV</label>
                <input id="cardCvv" class="form-control" placeholder="123" maxlength="3" />
            </div>
        </div>

        <button id="payBtn" type="button" class="btn btn-primary" style="width:100%; margin-top:10px;" onclick="submitPayment()">
            Pay @amount.ToString("C")
        </button>
    </div>

    <div id="payResult" style="margin-top:16px;"></div>
</div>

<script>
    async function submitPayment() {
        const btn = document.getElementById('payBtn');
        const resultBox = document.getElementById('payResult');
        btn.disabled = true;
        btn.textContent = 'Processing…';
        resultBox.innerHTML = '';

        try {
            const res = await fetch(`/api/payments/pay?registrationId=@registrationId&paymentMethod=Card`, { method: 'POST' });

            if (res.ok) {
                const data = await res.json();
                resultBox.innerHTML = `
                    <p style="color:#1a7f37; font-weight:600;">Payment successful.</p>
                    <p class="muted">Transaction ref: ${data.transactionRef}</p>
                    <a class="btn btn-primary" href="/Dashboard/Attendee">View my ticket</a>
                `;
                document.getElementById('payForm').style.display = 'none';
            } else {
                const errorText = await res.text();
                resultBox.innerHTML = `
                    <p style="color:#c62828; font-weight:600;">Payment declined (simulated).</p>
                    <p class="muted">${errorText}</p>
                `;
                btn.disabled = false;
                btn.textContent = 'Try again';
            }
        } catch (err) {
            resultBox.innerHTML = `<p style="color:#c62828;">Something went wrong. Please try again.</p>`;
            btn.disabled = false;
            btn.textContent = 'Try again';
        }
    }
</script>
